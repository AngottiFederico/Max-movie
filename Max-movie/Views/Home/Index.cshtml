@model List<Pelicula>
@{
    ViewData["Title"] = "Home Page";
    var paginaActual = ViewBag.PaginaActual as int? ?? 1;
    var totalPaginas = ViewBag.TotalPaginas as int? ?? 1;
    var busqueda = ViewBag.txtBusqueda as string ?? "";
    var filtroGenero = ViewBag.FiltroGenero as int? ?? 0;
    var filtroPlataforma = ViewBag.FiltroPlataforma as int? ?? 0;
    var generoId = @ViewBag.GeneroId ?? 0;
    var plataformaId = @ViewBag.PlataformaId ?? 0;
}

<main class="flex-grow-1">
    <div class="container py-4">
        @* Panel de filtros *@
        <form method="get">
            <div class="row g-3 mb-4 align-items-center">
                <div class="col-lg-6">
                    <div class="input-group">
                        <button type="submit" class="input-group-text"><span class="material-symbols-outlined">search</span></button>
                        <input name="txtBusqueda" value="@busqueda" class="form-control form-control-lg" placeholder="Buscar películas..." type="text" />
                    </div>
                </div>
                <div class="col-lg-6 d-flex flex-wrap gap-2 justify-content-lg-end align-items-center">

                    <div>
                        <select name="generoId" asp-items="@generoId" class="form-select form-select-lg" onchange="this.form.submit()"></select>
                    </div>

                    <div>
                        <select name="plataformaId" asp-items="@plataformaId" class="form-select form-select-lg" onchange="this.form.submit()"></select>
                    </div>
                    @*                     <div class="dropdown">
                        <button aria-expanded="false" class="btn btn-outline-secondary btn-lg dropdown-toggle" data-bs-toggle="dropdown" type="button">Calificación</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">5 estrellas</a></li>
                            <li><a class="dropdown-item" href="#">4 estrellas o más</a></li>
                            <li><a class="dropdown-item" href="#">3 estrellas o más</a></li>
                        </ul>
                    </div> *@
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary btn-lg" type="button"><span class="material-symbols-outlined align-middle">grid_view</span></button>
                        <button class="btn btn-outline-secondary btn-lg" type="button"><span class="material-symbols-outlined align-middle">list</span></button>
                    </div>
                </div>
            </div>
        </form>

        @*Listado *@
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4">
            @foreach (var pelicula in Model)
            {
                <div class="col">
                    <a asp-action="Details" asp-route-id="@pelicula.Id">
                        <div class="card h-100 border-0 shadow-sm">
                            <img alt="@pelicula.Titulo" class="card-img-top" src="@pelicula.PosterUrlPortada" />
                            <div class="card-body p-2">
                                <h5 class="card-title fs-6 fw-semibold mb-1 text-dark">@pelicula.Titulo</h5>
                                <div class="d-flex align-items-center text-muted small">
                                    <span class="material-symbols-outlined text-warning me-1" style="font-size: 1rem;">star</span>
                                    <span>@pelicula.PromedioRating</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>


        @* Paginación *@


        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación">
                <ul class="pagination justify-content-center mt-4">
                    <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                        <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@filtroGenero" asp-route-plataformaId="@filtroPlataforma" class="page-link">Anterior</a>
                    </li>
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a asp-action="Index" asp-route-pagina="@i" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@filtroGenero" asp-route-plataformaId="@filtroPlataforma" class="page-link">@i</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                        <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@filtroGenero" asp-route-plataformaId="@filtroPlataforma" class="page-link">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</main>
